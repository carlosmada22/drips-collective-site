{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/events-ra",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/bandcamp-releases",
      "schedule": "15 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
